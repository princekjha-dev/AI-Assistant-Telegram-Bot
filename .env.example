# Bot Environment Configuration
# Copy this file to .env and fill in your actual values

# Required credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional API keys
HF_API_TOKEN=
REPLICATE_API_TOKEN=

# Runtime mode
RUN_MODE=polling
POLLING_MODE=true
HOST=0.0.0.0
PORT=8080
WEBHOOK_URL=https://your-domain.example.com
WEBHOOK_SECRET_TOKEN=change-me

# LLM configuration
LLM_PROVIDER=openrouter
PRIMARY_MODEL=openai/gpt-4.1-mini
FALLBACK_MODEL=openai/gpt-4o-mini
DEFAULT_MODEL=openai/gpt-4.1-mini
IMAGE_GENERATION_MODEL=stabilityai/stable-diffusion-3

# Feature toggles
ENABLE_IMAGE_GENERATION=true
ENABLE_VOICE=true
ENABLE_WEB_SEARCH=false
ENABLE_ANALYTICS=true
ENABLE_PREMIUM_FEATURES=false
STRUCTURED_LOGS=false

# Performance and safety
MAX_RESPONSE_TOKENS=2000
TEMPERATURE=0.7
TOP_P=1.0
CONTEXT_WINDOW_SIZE=10
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
MAX_MESSAGE_LENGTH=4000
MAX_IMAGE_SIZE=10485760

# Paths and storage
DATABASE_PATH=./data/bot_database.db
DATABASE_BACKUP_PATH=./data/backups
MEDIA_STORAGE_PATH=./data/media
GENERATED_IMAGES_PATH=./data/generated_images
LOG_FILE=./logs/bot.log
SAVE_CONVERSATIONS=true

# Admin access
ADMIN_USER_IDS=123456789

# Scheduling and reminders
APSCHEDULER_TIMEZONE=UTC

# OpenRouter-specific options
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60
REQUEST_RETRY_ATTEMPTS=3
REQUEST_RETRY_DELAY=2
