# ============================================================
# NEXUS — Telegram AI Assistant Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Only TELEGRAM_BOT_TOKEN and OPENROUTER_API_KEY are required.
# ============================================================

# --- Core Credentials (REQUIRED) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- AI Model Configuration ---
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAX_TOKENS=2048
TEMPERATURE=0.7
CONTEXT_WINDOW=20

# --- Image Generation ---
IMAGE_PROVIDER=openrouter
IMAGE_MODEL=black-forest-labs/flux-schnell

# --- Database ---
DATABASE_URL=sqlite:///data/nexus.db

# --- Bot Mode: polling or webhook ---
MODE=polling

# Webhook settings (only required when MODE=webhook)
WEBHOOK_URL=https://yourdomain.com
WEBHOOK_PORT=8443
WEBHOOK_SECRET=your_random_webhook_secret

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=20
MAX_REQUESTS_PER_DAY=500

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/nexus.log

# --- Feature Flags ---
VOICE_ENABLED=true
IMAGE_GENERATION_ENABLED=true
GAMIFICATION_ENABLED=true
GROUP_MODE_ENABLED=true

# --- Admin ---
# Comma-separated Telegram user IDs with admin access
ADMIN_USER_IDS=

# --- App Info ---
BOT_NAME=Nexus
BOT_VERSION=1.0.0
